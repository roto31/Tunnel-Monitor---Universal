{
  "sections": [
    {
      "title": "SMTP",
      "fields": [
        {
          "key": "SMTP_SERVER",
          "label": "SMTP server",
          "secure": false,
          "default": "smtp.mail.me.com",
          "help": "e.g. smtp.mail.me.com (iCloud) or smtp.gmail.com"
        },
        {
          "key": "SMTP_PORT",
          "label": "SMTP port",
          "secure": false,
          "default": "587",
          "help": null
        },
        {
          "key": "SMTP_USER",
          "label": "SMTP username (email)",
          "secure": false,
          "default": "",
          "help": null
        },
        {
          "key": "SMTP_PASSWORD",
          "label": "App-specific password",
          "secure": true,
          "default": "",
          "help": "Generate at your mail provider; never use your main account password."
        },
        {
          "key": "ALERT_FROM",
          "label": "From address",
          "secure": false,
          "default": "",
          "help": "Many providers require this to match SMTP_USER."
        },
        {
          "key": "ALERT_TO",
          "label": "Alert recipient",
          "secure": false,
          "default": "",
          "help": null
        }
      ]
    },
    {
      "title": "Tunnel topology",
      "fields": [
        {
          "key": "REMOTE_LAN_IP",
          "label": "Remote LAN gateway (pinged over tunnel)",
          "secure": false,
          "default": "",
          "help": null
        },
        {
          "key": "REMOTE_WAN_IP",
          "label": "Remote public IP (expected)",
          "secure": false,
          "default": "",
          "help": null
        },
        {
          "key": "REMOTE_DDNS",
          "label": "DDNS hostname",
          "secure": false,
          "default": "",
          "help": "Should resolve to REMOTE_WAN_IP when healthy."
        }
      ]
    },
    {
      "title": "Gateway SSH (dedup)",
      "fields": [
        {
          "key": "GATEWAY_HOST",
          "label": "Gateway LAN IP (SSH)",
          "secure": false,
          "default": "192.168.1.1",
          "help": "Legacy UDR7_HOST / ROUTER_HOST still accepted in config.env."
        },
        {
          "key": "GATEWAY_USER",
          "label": "SSH user",
          "secure": false,
          "default": "root",
          "help": null
        },
        {
          "key": "GATEWAY_KEY",
          "label": "SSH private key path",
          "secure": false,
          "default": "/opt/tunnel-monitor/.ssh/id_ed25519",
          "help": null
        },
        {
          "key": "GATEWAY_STATE_PATH",
          "label": "Remote state file path",
          "secure": false,
          "default": "/data/tunnel-monitor/state",
          "help": null
        }
      ]
    },
    {
      "title": "Tuning & notifications",
      "fields": [
        {
          "key": "SUBJECT_PREFIX",
          "label": "Email subject prefix",
          "secure": false,
          "default": "[MAC]",
          "help": null
        },
        {
          "key": "FAILURE_THRESHOLD",
          "label": "Consecutive failures before alert",
          "secure": false,
          "default": "3",
          "help": null
        },
        {
          "key": "PING_COUNT",
          "label": "Pings per check",
          "secure": false,
          "default": "3",
          "help": null
        },
        {
          "key": "PING_TIMEOUT",
          "label": "Ping timeout (seconds)",
          "secure": false,
          "default": "2",
          "help": null
        },
        {
          "key": "NOTIFY_SOUND_DOWN",
          "label": "Banner sound (down)",
          "secure": false,
          "default": "Glass",
          "help": "Name from /System/Library/Sounds/"
        },
        {
          "key": "NOTIFY_SOUND_RECOVERY",
          "label": "Banner sound (recovery)",
          "secure": false,
          "default": "Hero",
          "help": null
        }
      ]
    }
  ]
}
