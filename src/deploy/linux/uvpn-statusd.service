[Unit]
Description=Universal VPN Monitor read-only status portal
Documentation=https://github.com/roto31/Tunnel-Monitor---Universal/blob/main/docs/deploy/status-portal.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uvpn-status
Group=uvpn-status
Environment=UVPN_CONFIG_DIR=/etc/uvpn
Environment=UVPN_STATUS_BIND=127.0.0.1:8080
Environment=UVPN_STATUS_TOKEN_FILE=/etc/uvpn/status-token
Environment=UVPN_STATUS_MASK_IPS=0
ExecStart=/usr/local/bin/uvpn-statusd
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/uvpn
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
