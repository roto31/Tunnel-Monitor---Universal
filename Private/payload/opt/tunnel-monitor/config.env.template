# =============================================================================
# Gam-and-Bee Tunnel Monitor — Mac Studio configuration
# =============================================================================
# Copy this file to /opt/tunnel-monitor/config.env (chmod 0600) and fill in the
# SMTP password. Everything else has working defaults for the current topology.
# =============================================================================

# --- iCloud SMTP -------------------------------------------------------------
# REQUIRES AN APP-SPECIFIC PASSWORD (NOT your regular Apple ID password).
# Generate one at: https://account.apple.com -> Sign-In and Security ->
#                  App-Specific Passwords
SMTP_SERVER="smtp.mail.me.com"
SMTP_PORT="587"
SMTP_USER="roto1231@mac.com"
SMTP_PASSWORD="REPLACE_WITH_APP_SPECIFIC_PASSWORD"
ALERT_FROM="roto1231@mac.com"
ALERT_TO="roto1231@mac.com"

# --- Tunnel topology ---------------------------------------------------------
REMOTE_LAN_IP="192.168.0.1"
REMOTE_WAN_IP="75.73.219.205"
REMOTE_DDNS="gamandbeeu.onthewifi.com"

# --- UDR7 dedup --------------------------------------------------------------
UDR7_HOST="192.168.1.1"
UDR7_USER="root"
UDR7_KEY="/opt/tunnel-monitor/.ssh/id_ed25519"
UDR7_STATE_PATH="/data/tunnel-monitor/state"

# --- Detection tuning --------------------------------------------------------
FAILURE_THRESHOLD="3"
PING_COUNT="3"
PING_TIMEOUT="2"

# --- Subject prefix ----------------------------------------------------------
# Distinguishes Mac-originated alerts from UDR7-originated alerts in the inbox.
# Do not change unless coordinating with UDR7 monitor changes.
SUBJECT_PREFIX="[STUDIO]"

# --- Notification settings ---------------------------------------------------
NOTIFY_SOUND_DOWN="Glass"
NOTIFY_SOUND_RECOVERY="Hero"
